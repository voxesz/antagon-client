{
  "name": "antagon-client",
  "productName": "Antagon Client",
  "version": "0.1.0",
  "description": "Minecraft 1.8.9 PvP client for macOS: launcher, HUD mods and a Right Shift menu.",
  "main": "electron/main.cjs",
  "author": "Antagon Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install:game": "node scripts/prepare.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "test:game": "node scripts/smoke-game.cjs",
    "build:mod": "node scripts/build-mod.cjs",
    "format": "prettier --write .",
    "prepackage": "npm run build:mod",
    "package": "electron-packager . 'Antagon Client' --platform=darwin --arch=arm64 --out=release --overwrite --icon=assets/icon.icns --ignore='^/(release|build|tests|docs|scripts|mod-src)(/|$)'"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "msmc": "5.0.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "44.4.5",
    "playwright": "1.58.2",
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voxesz/antagon-client.git"
  }
}
